# Plantilla global para Docker Compose de Angelow.
# Copiar como .env en la raíz del repositorio y reemplazar los valores del ambiente.
# Este archivo no reemplaza los ejemplos de cada servicio Laravel.
# Nunca versionar .env ni colocar aquí contraseñas, APP_KEY reales o tokens internos.

# URL que usan los servicios para CORS, enlaces y notificaciones.
# En producción: https://angelow.online
FRONTEND_URL=http://localhost:5173

# Secretos/integraciones interpolados por docker-compose.yml.
MAIL_PASSWORD=
MAPBOX_ACCESS_TOKEN=
PHPMAILER_PASSWORD=
TURNSTILE_SECRET_KEY=

# URLs públicas del frontend. En local apuntan a los puertos publicados;
# en producción deben apuntar al dominio HTTPS y al WebSocket seguro.
VITE_AUTH_API_URL=http://localhost:8001/api
VITE_CATALOG_API_URL=http://localhost:8002/api
VITE_CART_API_URL=http://localhost:8003/api
VITE_ORDER_API_URL=http://localhost:8004/api
VITE_PAYMENT_API_URL=http://localhost:8005/api
VITE_DISCOUNT_API_URL=http://localhost:8006/api
VITE_SHIPPING_API_URL=http://localhost:8007/api
VITE_NOTIFICATION_API_URL=http://localhost:8008/api
VITE_STOCK_WS_URL=ws://localhost:8090
VITE_UPLOADS_BASE_URL=http://localhost:5173/uploads
VITE_SHIPPING_PUBLIC_URL=http://localhost:8007

# Configuración pública del cliente Firebase y Turnstile.
# Completar con la configuración del proyecto correspondiente al ambiente.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_TURNSTILE_SITE_KEY=

# Para producción, sustituir como mínimo:
# FRONTEND_URL=https://angelow.online
# VITE_AUTH_API_URL=https://angelow.online/api/auth-service
# VITE_CATALOG_API_URL=https://angelow.online/api/catalog-service
# VITE_CART_API_URL=https://angelow.online/api/cart-service
# VITE_ORDER_API_URL=https://angelow.online/api/order-service
# VITE_PAYMENT_API_URL=https://angelow.online/api/payment-service
# VITE_DISCOUNT_API_URL=https://angelow.online/api/discount-service
# VITE_SHIPPING_API_URL=https://angelow.online/api/shipping-service
# VITE_NOTIFICATION_API_URL=https://angelow.online/api/notification-service
# VITE_STOCK_WS_URL=wss://angelow.online/ws/stock
# VITE_UPLOADS_BASE_URL=https://angelow.online/uploads
# VITE_SHIPPING_PUBLIC_URL=https://angelow.online
