# ──────────────────────────────────────────────
# Configuración de entorno del audit-service
# Copia este archivo como .env y ajusta los valores
# según tu entorno de desarrollo o producción.
# ──────────────────────────────────────────────

# Aplicación
APP_NAME=AngelowAudit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8009

# Localización
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

# Mantenimiento
APP_MAINTENANCE_DRIVER=file

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=audit-db
DB_PORT=5432
DB_DATABASE=angelow_audit
DB_USERNAME=postgres
DB_PASSWORD=root
DB_SCHEMA=public

# Colas y Caché (Redis)
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=angelow_audit

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=6
REDIS_CACHE_DB=6
