# ──────────────────────────────────────────────
# Configuración de entorno del auth-service
# Copia este archivo como .env y ajusta los valores
# según tu entorno de desarrollo o producción.
# ──────────────────────────────────────────────

# Aplicación
APP_NAME=AngelowAuth
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

# Localización
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

# Mantenimiento
APP_MAINTENANCE_DRIVER=file

# Seguridad (cifrado de contraseñas)
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=auth-db
DB_PORT=5432
DB_DATABASE=angelow_auth
DB_USERNAME=postgres
DB_PASSWORD=root
DB_SCHEMA=public

# Sesión
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting / Archivos / Colas
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Caché (Redis)
CACHE_STORE=redis
CACHE_PREFIX=angelow_auth

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=0

# Correo (Laravel Mail)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@angelow.com"
MAIL_FROM_NAME="${APP_NAME}"

# CORS / Frontend SPA
SANCTUM_STATEFUL_DOMAINS=localhost:5173
FRONTEND_URL=http://localhost:5173

# Assets (Vite)
VITE_APP_NAME="${APP_NAME}"

# Firebase (verificación de token Google)
FIREBASE_WEB_API_KEY=AIzaSyBQMRz1TvRiQAYt_PlimHGZHpuP-NSJt5k

# Verificación de seguridad Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
AUTH_LOGIN_CAPTCHA_AFTER_ATTEMPTS=3
AUTH_LOGIN_TEMP_BLOCK_AFTER_ATTEMPTS=8
AUTH_LOGIN_TEMP_BLOCK_MINUTES=15

# Token de acceso interno entre microservicios
INTERNAL_API_TOKEN=

# Recuperación de contraseña
PASSWORD_RECOVERY_CODE_TTL=900
PASSWORD_RECOVERY_RESEND_COOLDOWN=60
REGISTRATION_VERIFICATION_CODE_TTL=900
REGISTRATION_VERIFICATION_RESEND_COOLDOWN=60

# PHPMailer (SMTP para correos transaccionales)
PHPMAILER_HOST=smtp.gmail.com
PHPMAILER_PORT=587
PHPMAILER_USERNAME=
PHPMAILER_PASSWORD=
PHPMAILER_ENCRYPTION=tls
PHPMAILER_FROM_EMAIL=seguridad@angelow.com
PHPMAILER_FROM_NAME="Seguridad Angelow"
