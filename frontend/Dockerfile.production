FROM node:20-alpine AS build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .

ARG VITE_AUTH_API_URL
ARG VITE_CATALOG_API_URL
ARG VITE_CART_API_URL
ARG VITE_ORDER_API_URL
ARG VITE_PAYMENT_API_URL
ARG VITE_DISCOUNT_API_URL
ARG VITE_SHIPPING_API_URL
ARG VITE_NOTIFICATION_API_URL
ARG VITE_STOCK_WS_URL
ARG VITE_UPLOADS_BASE_URL
ARG VITE_SHIPPING_PUBLIC_URL
ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_STORAGE_BUCKET
ARG VITE_FIREBASE_MESSAGING_SENDER_ID
ARG VITE_FIREBASE_APP_ID
ARG VITE_FIREBASE_MEASUREMENT_ID
ARG VITE_TURNSTILE_SITE_KEY

ENV VITE_AUTH_API_URL=$VITE_AUTH_API_URL \
    VITE_CATALOG_API_URL=$VITE_CATALOG_API_URL \
    VITE_CART_API_URL=$VITE_CART_API_URL \
    VITE_ORDER_API_URL=$VITE_ORDER_API_URL \
    VITE_PAYMENT_API_URL=$VITE_PAYMENT_API_URL \
    VITE_DISCOUNT_API_URL=$VITE_DISCOUNT_API_URL \
    VITE_SHIPPING_API_URL=$VITE_SHIPPING_API_URL \
    VITE_NOTIFICATION_API_URL=$VITE_NOTIFICATION_API_URL \
    VITE_STOCK_WS_URL=$VITE_STOCK_WS_URL \
    VITE_UPLOADS_BASE_URL=$VITE_UPLOADS_BASE_URL \
    VITE_SHIPPING_PUBLIC_URL=$VITE_SHIPPING_PUBLIC_URL \
    VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY \
    VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN \
    VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID \
    VITE_FIREBASE_STORAGE_BUCKET=$VITE_FIREBASE_STORAGE_BUCKET \
    VITE_FIREBASE_MESSAGING_SENDER_ID=$VITE_FIREBASE_MESSAGING_SENDER_ID \
    VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID \
    VITE_FIREBASE_MEASUREMENT_ID=$VITE_FIREBASE_MEASUREMENT_ID \
    VITE_TURNSTILE_SITE_KEY=$VITE_TURNSTILE_SITE_KEY

RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx/templates /etc/nginx/templates
COPY deploy/nginx/proxy_params /etc/nginx/proxy_params
COPY deploy/nginx/start-nginx.sh /docker-entrypoint.d/40-select-config.sh

RUN chmod +x /docker-entrypoint.d/40-select-config.sh \
    && rm -f /etc/nginx/conf.d/default.conf

EXPOSE 80 443
